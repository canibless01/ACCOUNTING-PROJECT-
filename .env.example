# ================================================================
# Holy Grills API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Every key listed here maps to a required Config attribute in config.py.
# ================================================================

# ── Supabase ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key...
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Gmail OAuth ──────────────────────────────────────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type).
# Add your GMAIL_REDIRECT_URI value as an Authorised Redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Development: http://localhost:5001/api/sync/gmail/callback
# Production: https://your-domain.com/api/sync/gmail/callback
GMAIL_REDIRECT_URI=http://localhost:5001/api/sync/gmail/callback

# ── Token encryption ─────────────────────────────────────────────
# AES-256-CBC key used to encrypt Gmail OAuth tokens at rest.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# KEEP THIS SECRET. If compromised, rotate it and bump the version below.
TOKEN_ENCRYPTION_KEY=64-hex-characters-here
# Increment when you rotate the key so old records can be identified for re-encryption.
TOKEN_ENCRYPTION_KEY_VERSION=1

# ── Flask ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=another-64-hex-characters-here
FLASK_DEBUG=false
# Port the Flask dev server listens on (also used by Gunicorn in production).
PORT=5001

# ── Frontend ─────────────────────────────────────────────────────
# Used for CORS and OAuth redirect validation.
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000

# ── Cron auth ────────────────────────────────────────────────────
# Sent as the X-Cron-Key header from your cron service (e.g. cron-job.org).
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
CRON_SECRET=your-cron-secret-here

# ── Optional tuning ──────────────────────────────────────────────
# Days to backfill on first sync (default: 90).
BACKFILL_DAYS=90
# Max Gmail messages fetched per sync run (default: 500).
GMAIL_MAX_RESULTS=500
# Number of days before failed_imports are auto-purged (default: 30).
FAILED_IMPORT_TTL_DAYS=30
# Years before transactions are archived (default: 2).
TRANSACTION_ARCHIVE_YEARS=2
# Temp directory for PDF/Excel export files.
EXPORT_TEMP_DIR=/tmp/holy_grills_exports
